{
  "name": "@bubblebrain-ai/bubble",
  "version": "0.0.8",
  "description": "A terminal coding agent",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "bubble": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/bin.js dist/main.js",
    "dev": "tsc && bun dist/main.js",
    "prepack": "npm run build",
    "start": "bun dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentui/core": "^0.1.99",
    "@opentui/solid": "^0.1.99",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@vue/language-server": "^3.2.7",
    "better-sqlite3": "^12.9.0",
    "chalk": "^5.3.0",
    "diff": "^7.0.0",
    "ink": "^7.0.3",
    "openai": "^4.77.0",
    "opentui-spinner": "^0.0.6",
    "picomatch": "^4.0.4",
    "react": "^19.2.6",
    "shiki": "^4.0.2",
    "solid-js": "^1.9.11",
    "string-width": "^8.2.1",
    "typescript-language-server": "^5.1.3",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-langservers-extracted": "^4.10.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
