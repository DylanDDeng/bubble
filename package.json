{
  "name": "@bubblebrain-ai/bubble",
  "version": "0.0.54",
  "description": "A terminal coding agent",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "bubble": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "scripts": {
    "build": "npm run build:vendor && rm -rf dist && tsc && chmod +x dist/bin.js dist/main.js",
    "build:vendor": "tsc -p packages/pi-tui/tsconfig.build.json",
    "test:vendor": "cd packages/pi-tui && node --test --experimental-strip-types --no-warnings \"test/*.test.ts\"",
    "test:package": "node scripts/verify-packed-install.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "dev": "tsc && node dist/main.js",
    "refresh-models": "NODE_USE_ENV_PROXY=1 node scripts/generate-model-data.mjs",
    "eval": "tsx evals/run.ts",
    "prepack": "npm run build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@ai-sdk/google": "^3.0.88",
    "@ai-sdk/provider": "^3.0.13",
    "@bubblebrain-ai/pi-tui": "file:packages/pi-tui",
    "@larksuiteoapi/node-sdk": "^1.65.0",
    "@types/better-sqlite3": "^7.6.13",
    "@vue/language-server": "^3.2.7",
    "better-sqlite3": "^13.0.1",
    "chalk": "^5.3.0",
    "diff": "^9.0.0",
    "get-east-asian-width": "1.6.0",
    "js-tiktoken": "^1.0.21",
    "marked": "18.0.5",
    "openai": "^4.77.0",
    "picomatch": "^4.0.4",
    "qrcode-terminal": "^0.12.0",
    "quickjs-emscripten": "^0.32.0",
    "shiki": "^4.0.2",
    "string-width": "^8.2.1",
    "typescript-language-server": "^5.1.3",
    "undici": "^6.26.0",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-langservers-extracted": "^4.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^4.1.4",
    "@xterm/headless": "5.5.0",
    "node-pty": "^1.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "axios": "^1.17.0",
    "postcss": "^8.5.15",
    "ws": "^8.21.0",
    "openai": {
      "zod": "$zod"
    }
  },
  "allowScripts": {
    "tsx@4.23.12": true,
    "node-pty@1.1.0": true
  },
  "bundleDependencies": [
    "@bubblebrain-ai/pi-tui",
    "marked"
  ]
}
