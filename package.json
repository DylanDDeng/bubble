{
  "name": "@bubblebrain-ai/bubble",
  "version": "0.0.47",
  "description": "A terminal coding agent",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "bubble": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/bin.js dist/main.js",
    "dev": "tsc && bun dist/main.js",
    "refresh-models": "NODE_USE_ENV_PROXY=1 node scripts/generate-model-data.mjs",
    "eval": "bun evals/run.ts",
    "prepack": "npm run build",
    "start": "bun dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@ai-sdk/google": "^3.0.88",
    "@ai-sdk/provider": "^3.0.13",
    "@larksuiteoapi/node-sdk": "^1.65.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@vue/language-server": "^3.2.7",
    "better-sqlite3": "^13.0.1",
    "chalk": "^5.3.0",
    "diff": "^9.0.0",
    "ink": "^7.0.3",
    "js-tiktoken": "^1.0.21",
    "openai": "^4.77.0",
    "picomatch": "^4.0.4",
    "qrcode-terminal": "^0.12.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.2.6",
    "shiki": "^4.0.2",
    "string-width": "^8.2.1",
    "typescript-language-server": "^5.1.3",
    "undici": "^6.26.0",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-langservers-extracted": "^4.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^4.1.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "axios": "^1.17.0",
    "postcss": "^8.5.15",
    "ws": "^8.21.0",
    "openai": {
      "zod": "$zod"
    }
  }
}
