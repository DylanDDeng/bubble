{
  "name": "bubble-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Bubble desktop agent",
  "author": "BubbleBrain",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
    "dev": "npm run build && npm start",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/package.mjs",
    "trace:preview": "vite --host 127.0.0.1 --port 4327"
  },
  "dependencies": {
    "dompurify": "^3.2.7",
    "lucide-react": "^0.468.0",
    "marked": "18.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "43.2.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.0"
  }
}
